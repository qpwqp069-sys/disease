{
	"schemaVersion": 1,
	"id": "diseases",
	"version": "${version}",
	"name": "Diseases (Vetka Fix)",
	"description": "Random real-life-style diseases every 6-8 minutes with unique debuffs.",
	"authors": [
		"diseasemod"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/FabricMC/fabric-example-mod"
	},
	"license": "CC0-1.0",
	"icon": "assets/diseases/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.diseasemod.Diseases"
		],
		"client": [
			"com.diseasemod.client.DiseasesClient"
		]
	},
	"mixins": [
		"diseases.mixins.json",
		{
			"config": "diseases.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=0.20.1",
		"minecraft": "~1.21.11",
